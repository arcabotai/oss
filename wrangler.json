{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arca-oss",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
